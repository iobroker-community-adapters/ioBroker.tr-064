// Type check of tasks.ts and tasks-oui.ts, which run with tsx (`npm run check`)
{
    "extends": "@tsconfig/node22/tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "types": ["node"]
    },
    "include": ["tasks.ts", "tasks-oui.ts"]
}
