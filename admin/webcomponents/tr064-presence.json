{
    "$schema": "https://raw.githubusercontent.com/ioBroker/web-components/main/schemas/manifest.json",
    "manifestVersion": 1,
    "tag": "iob-tr064-presence",
    "module": "tr064-presence.js",
    "name": {
        "en": "Presence",
        "de": "Anwesenheit",
        "ru": "Присутствие",
        "pt": "Presença",
        "nl": "Aanwezigheid",
        "fr": "Présence",
        "it": "Presenza",
        "es": "Presencia",
        "pl": "Obecność",
        "uk": "Присутність",
        "zh-cn": "在家状态"
    },
    "description": {
        "en": "The devices of the tab \"Devices\" or the persons of the tab \"Persons\" of the instance: present or away",
        "de": "Die Geräte des Reiters \"Geräte\" oder die Personen des Reiters \"Personen\" der Instanz: anwesend oder abwesend",
        "ru": "Устройства вкладки «Устройства» или люди вкладки «Персоны» экземпляра: дома или нет",
        "pt": "Os dispositivos da aba \"Dispositivos\" ou as pessoas da aba \"Pessoas\" da instância: presentes ou ausentes",
        "nl": "De apparaten van het tabblad \"Apparaten\" of de personen van het tabblad \"Personen\" van de instantie: aanwezig of afwezig",
        "fr": "Les appareils de l'onglet « Appareils » ou les personnes de l'onglet « Personnes » de l'instance : présents ou absents",
        "it": "I dispositivi della scheda \"Dispositivi\" o le persone della scheda \"Persone\" dell'istanza: presenti o assenti",
        "es": "Los dispositivos de la pestaña \"Dispositivos\" o las personas de la pestaña \"Personas\" de la instancia: presentes o ausentes",
        "pl": "Urządzenia z zakładki „Urządzenia” lub osoby z zakładki „Osoby” instancji: obecne lub nieobecne",
        "uk": "Пристрої вкладки «Пристрої» або особи вкладки «Особи» екземпляра: вдома чи ні",
        "zh-cn": "实例“设备”选项卡中的设备或“人员”选项卡中的人员：在场或离开"
