{
    "i18n": true,
    "type": "tabs",
    "items": {
        "_options": {
            "type": "panel",
            "label": "Options",
            "items": {
                "_logo": {
                    "type": "staticImage",
                    "src": "tr-064.svg",
                    "style": {
                        "width": "64px"
                    },
                    "xs": 12,
                    "sm": 12,
                    "md": 2,
                    "lg": 1,
                    "xl": 1
                },
                "iporhost": {
                    "type": "text",
                    "label": "IP",
                    "help": "tooltip_ip",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "pollingInterval": {
                    "type": "number",
                    "label": "Polling interval (sec)",
                    "min": 0,
                    "max": 3600,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 2,
                    "xl": 2
                },
                "user": {
                    "type": "text",
                    "label": "User",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "password": {
                    "type": "password",
                    "label": "Password",
                    "encrypted": true,
                    "visible": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "useCallMonitor": {
                    "type": "checkbox",
                    "label": "Use CallMonitor",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "usePhonebook": {
                    "type": "checkbox",
                    "label": "Use phonebook",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "useDeflectionOptions": {
                    "type": "checkbox",
                    "label": "Use call forwarding options",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "useDevices": {
                    "type": "checkbox",
                    "label": "Watch devices",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "useMDNS": {
                    "type": "checkbox",
                    "label": "Use MDNS",
                    "help": "tooltip_useMDNS",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "jsonDeviceList": {
                    "type": "checkbox",
                    "label": "Create Json device list",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                }
            }
        },
        "_devices": {
            "type": "panel",
            "label": "Devices",
            "items": {
                "_find": {
                    "type": "sendTo",
                    "command": "discovery",
                    "jsonData": "{\"onlyActive\": true, \"reread\": true, \"native\": true, \"devices\": ${JSON.stringify(data.devices || [])}}",
                    "useNative": true,
                    "showProcess": true,
                    "timeout": 20000,
                    "icon": "search",
                    "variant": "outlined",
                    "label": "Find a device",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "devices": {
                    "type": "table",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 4,
                    "xl": 4
                    "uniqueColumns": ["mac"],
                    "items": [
                        {
                            "type": "text",
                            "attr": "name",
                            "title": "name",
                            "width": "34%",
                            "filter": false,
                            "sort": false,
                            "default": ""
                        },
                        {
                            "type": "text",
                            "attr": "ip",
                            "title": "ip",
                            "width": "33%",
                            "filter": false,
                            "sort": false,
                            "default": ""
                        },
                        {
                            "type": "text",
                            "attr": "mac",
                            "title": "MAC",
                            "width": "33%",
                            "filter": false,
                            "sort": false,
                            "default": ""
                        }
                    ]
                }
            }
        },
        "_calllists": {
            "type": "panel",
            "label": "Calllists",
            "items": {
                "_headerAll": {
                    "type": "header",
                    "text": "All calls",
                    "size": 5,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "calllists.all.generateJson": {
                    "type": "checkbox",
                    "label": "Generate JSON",
                    "default": true,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "calllists.all.generateHtml": {
                    "type": "checkbox",
                    "label": "Generate HTML",
                    "default": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "calllists.all.maxEntries": {
                    "type": "number",
                    "label": "max Entries",
                    "min": 0,
                    "max": 999,
                    "default": 10,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },

                "_headerMissed": {
                    "type": "header",
                    "text": "Missed calls",
                    "size": 5,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "calllists.missed.generateJson": {
                    "type": "checkbox",
                    "label": "Generate JSON",
                    "default": true,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "calllists.missed.generateHtml": {
                    "type": "checkbox",
                    "label": "Generate HTML",
                    "default": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "calllists.missed.maxEntries": {
                    "type": "number",
                    "label": "max Entries",
                    "min": 0,
                    "max": 999,
                    "default": 10,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 3
                },

                "_headerInbound": {
                    "type": "header",
                    "text": "Inbound",
                    "size": 5,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "calllists.inbound.generateJson": {
                    "type": "checkbox",
                    "label": "Generate JSON",
                    "default": true,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "calllists.inbound.generateHtml": {
                    "type": "checkbox",
                    "label": "Generate HTML",
                    "default": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "calllists.inbound.maxEntries": {
                    "type": "number",
                    "label": "max Entries",
                    "min": 0,
                    "max": 999,
                    "default": 10,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },

                "_headerOutbound": {
                    "type": "header",
                    "text": "Outbound",
                    "size": 5,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "calllists.outbound.generateJson": {
                    "type": "checkbox",
                    "label": "Generate JSON",
                    "default": true,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "calllists.outbound.generateHtml": {
                    "type": "checkbox",
                    "label": "Generate HTML",
                    "default": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "calllists.outbound.maxEntries": {
                    "type": "number",
                    "label": "max Entries",
                    "min": 0,
                    "max": 999,
                    "default": 10,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                }
            }
        }
    }
}
